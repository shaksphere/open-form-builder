# Open Form Builder — example environment file.
# Copy to `.env` (gitignored) for local testing. Do NOT commit real keys.
#
# Stripe keys are entered in the WordPress admin (Form Builder → Settings),
# NOT read from this file at runtime. This file only keeps local test keys
# handy and out of version control.
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_TEST_SECRET_KEY=sk_test_xxx
